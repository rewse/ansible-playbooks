{{ ansible_managed | comment }}
name: litellm

services:
  litellm:
    container_name: litellm
    image: {{ __litellm_image.ref }}
    ports:
      # Reached only through the Apache vhost, which terminates TLS.
      - "127.0.0.1:4000:4000"
    volumes:
      - /srv/litellm/config.yml:/app/config.yml:ro
    environment:
      - AWS_ACCESS_KEY_ID={{ litellm_aws_access_key_id }}
      - AWS_SECRET_ACCESS_KEY={{ litellm_aws_secret_access_key }}
      - AWS_REGION_NAME=us-east-1
      - LITELLM_MASTER_KEY={{ litellm_master_key }}
      - LITELLM_SALT_KEY={{ litellm_salt_key }}
    restart: unless-stopped
    command: ["--config", "/app/config.yml", "--port", "4000"]
