{{ ansible_managed | comment }}
<VirtualHost *:443>
    ServerAdmin hostmaster@rewse.jp
    ServerName couchdb.rewse.jp

    ProxyPreserveHost on
    ProxyRequests off
    ProxyPass / http://127.0.0.1:5984/
    ProxyPassReverse / http://127.0.0.1:5984/
    ProxyPass /api/websocket ws://127.0.0.1:5984/api/websocket
    ProxyPassReverse /api/websocket ws://127.0.0.1:5984/api/websocket

    RewriteEngine on
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule /(.*)  ws://127.0.0.1:5984/$1 [P,L]
    RewriteCond %{HTTP:Upgrade} !=websocket [NC]
    RewriteRule /(.*)  http://127.0.0.1:5984/$1 [P,L]

    # Obsidian LiveSync replicates through the database paths and signs in
    # through /_session, so both stay open to every network. A database name
    # cannot begin with an underscore, so every other path that does is a
    # server-level endpoint (Fauxton, node config, replication, _users), used
    # only from home, the VPN, and the office. Behind CloudFront, mod_remoteip
    # has already restored the client address that Require ip tests.
    <LocationMatch "^/_(?!session$)">
        Require ip 127.0.0.1
        Require ip ::1
        Require ip {{ networks.home_private_ipv4 }}
        Require ip {{ networks.home_private_ipv6 }}
        Require ip {{ networks.home_public_ipv4 }}
        Require ip {{ networks.home_public_ipv6 }}
        Require ip {{ networks.aws_private_ipv4 }}
        Require ip {{ networks.aws_public_ipv6 }}
        Require ip {{ networks.office_public_ipv4 | join(' ') }}
    </LocationMatch>

    SSLCertificateFile /etc/letsencrypt/live/rewse.jp/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/rewse.jp/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
