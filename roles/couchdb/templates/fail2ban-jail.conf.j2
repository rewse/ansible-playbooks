{{ ansible_managed | comment }}
#
# Reads the Apache log rather than CouchDB's own, for the reason in the filter.
#
# backend is stated because jail.d/defaults-debian.conf from the package sets
# systemd for every jail and jail.d is read after jail.local. Without it the jail
# reads the journal and watches no file, while fail2ban-client status still
# reports it enabled; get <jail> logpath is what tells the two apart.
[couchdb]
enabled = true
backend = auto
port = http,https
filter = couchdb
logpath = /var/log/apache2/other_vhosts_access.log
