#!/bin/bash
set -uo pipefail

PRIMARY_HOST="fox.rewse.jp"
PRIMARY_API="http://${PRIMARY_HOST}:8123/api/"
PRIMARY_SSH_PORT="11022"
PRIMARY_SSH_USER="[% admin %]"
HA_TOKEN="[% homeassistant_ha_token %]"
HEALTHCHECK_TIMEOUT=5
# How long the primary has to stay unreachable before the standby takes over.
# The timer fires every 5 minutes, so the clock is kept in a file rather than by
# retrying within one run: a primary that reboots is back long before this.
FAILOVER_AFTER=[% homeassistant_ha_failover_after %]
STATE_DIR="/var/lib/homeassistant-ha"
# When the primary was first seen unreachable, absent while it answers.
DOWN_SINCE_FILE="${STATE_DIR}/down-since"
# Present while someone runs Home Assistant here on purpose, which keeps this
# from stopping it the moment the primary answers again.
HOLD_FILE="${STATE_DIR}/hold"
LOCK_FILE="/var/run/homeassistant-failover.lock"
LOG_TAG="homeassistant-failover"
MAIL_TO="[% email.primary %]"
COMPOSE_DIR="/etc"
DOMAIN="[% homeassistant_ha_domain %]"
NAME_SWITCH="/usr/local/bin/homeassistant-name-switch"
# Written by the name switch while the name points here.
NAME_SWITCHED_FILE="${STATE_DIR}/name-switched"

log() {
    logger -t "${LOG_TAG}" "$1"
    echo "$(date '+%Y-%m-%d %H:%M:%S') $1"
}

cleanup() {
    rm -f "${LOCK_FILE}"
}

send_mail() {
    local subject="$1"
    local body="$2"

    if command -v mail >/dev/null 2>&1; then
        echo "${body}" | mail -s "${subject}" "${MAIL_TO}" || \
            log "Failed to send notification email to ${MAIL_TO}"
    else
        log "mail command not found; skipping email notification"
    fi
}

local_ha_running() {
    docker ps --format '{{.Names}}' | grep -q '^homeassistant$'
}

# 2xx/3xx means Home Assistant is up and the token is accepted.
check_primary_api() {
    local http_code
    http_code=$(curl --silent --max-time "${HEALTHCHECK_TIMEOUT}" -o /dev/null -w "%{http_code}" -H "Authorization: Bearer ${HA_TOKEN}" "${PRIMARY_API}" 2>/dev/null || echo "000")
    case "${http_code}" in
        2??|3??)
            return 0
            ;;
        *)
            log "Primary API returned HTTP ${http_code}"
            return 1
            ;;
    esac
}

# Prevent double execution
if [ -e "${LOCK_FILE}" ]; then
    log "Lock file exists; another instance is running. Exiting."
    exit 0
fi

touch "${LOCK_FILE}"
trap cleanup EXIT

# The clock lives here, so failover stops working silently if the directory is gone.
mkdir -p "${STATE_DIR}"

hostname_local=$(hostname)

# -----------------------------------------------------------------------------
# Standby is serving: stand down once the primary is back
# -----------------------------------------------------------------------------
# The primary starts its own container on boot (unless-stopped), so without this
# both would run against the same MQTT broker until someone noticed. Checking the
# primary before stopping anything means there is no moment with neither serving.
if local_ha_running; then
    if [ -e "${HOLD_FILE}" ]; then
        log "Standby is serving and ${HOLD_FILE} is present; leaving it alone."
        exit 0
    fi

    if ! check_primary_api; then
        log "Standby is serving and the primary is still unreachable; staying."
        exit 0
    fi

    log "Primary is answering again; standing down on ${hostname_local}"

    # The name goes back first: stopping the container while the name still points
    # here would answer requests with a proxy error rather than the primary.
    if "${NAME_SWITCH}" primary; then
        name_status="moved back to the primary"
    else
        name_status="NOT moved back, still points here"
        log "Continuing to stand down even though the name did not move"
    fi

    if docker compose -f "${COMPOSE_DIR}/compose.yml" stop homeassistant; then
        log "Stopped Home Assistant on ${hostname_local}"
        standdown_status="SUCCESS"
    else
        log "Failed to stop Home Assistant on ${hostname_local}"
        standdown_status="FAILED"
    fi

    rm -f "${DOWN_SINCE_FILE}"

    send_mail \
        "[INFO] Home Assistant Stand-down: ${hostname_local} -> ${PRIMARY_HOST} (${standdown_status})" \
        "$(cat <<EOF
The primary is serving again, so the standby has stopped its Home Assistant.

Stand-down time : $(date '+%Y-%m-%d %H:%M:%S %Z')
Standby host    : ${hostname_local}
Primary host    : ${PRIMARY_HOST}
Result          : ${standdown_status}
Name            : ${name_status}

Configuration changes made here while it was serving are discarded:
homeassistant-sync resumes now that the container is stopped and mirrors the
primary's configuration back over this one.

Current status on ${hostname_local}:
$(docker ps -a --filter name=homeassistant --format 'table {{.Names}}\t{{.Status}}')

--
${LOG_TAG} on ${hostname_local}
EOF
)"

    exit 0
fi

# -----------------------------------------------------------------------------
# Standby is idle: take over once the primary has been down long enough
# -----------------------------------------------------------------------------
if check_primary_api; then
    if [ -f "${DOWN_SINCE_FILE}" ]; then
        log "Primary is answering again; clearing the clock without failing over."
        rm -f "${DOWN_SINCE_FILE}"
    fi
    # A stand-down whose name switch failed leaves the name here with nothing
    # serving it, so it is retried for as long as the marker says it is ours.
    if [ -f "${NAME_SWITCHED_FILE}" ]; then
        log "The name still points here while the primary serves; moving it back."
        "${NAME_SWITCH}" primary || log "Could not move the name back; will retry."
    fi
    exit 0
fi

now=$(date +%s)

if [ ! -f "${DOWN_SINCE_FILE}" ]; then
    echo "${now}" > "${DOWN_SINCE_FILE}"
    log "Primary is unreachable; waiting ${FAILOVER_AFTER}s before failing over."
    exit 0
fi

down_since=$(cat "${DOWN_SINCE_FILE}" 2>/dev/null)
# An unreadable clock would postpone failover forever, so start it again.
if ! [ "${down_since}" -gt 0 ] 2>/dev/null; then
    log "Clock file ${DOWN_SINCE_FILE} is unusable; starting it again."
    echo "${now}" > "${DOWN_SINCE_FILE}"
    exit 0
fi

elapsed=$((now - down_since))

if [ "${elapsed}" -lt "${FAILOVER_AFTER}" ]; then
    log "Primary has been unreachable for ${elapsed}s of ${FAILOVER_AFTER}s; waiting."
    exit 0
fi

log "Primary has been unreachable for ${elapsed}s; checking container status via SSH"

# Check container status via SSH
ssh_container_status=$(ssh \
    -o BatchMode=yes \
    -o ConnectTimeout=10 \
    -o StrictHostKeyChecking=accept-new \
    -p "${PRIMARY_SSH_PORT}" \
    "${PRIMARY_SSH_USER}@${PRIMARY_HOST}" \
    "docker ps --format '{{.Names}}' | grep -q '^homeassistant\$' && echo running || echo stopped" 2>/dev/null || echo "unreachable")

log "Primary container status: ${ssh_container_status}"

case "${ssh_container_status}" in
    running)
        log "Primary container is running but API is unreachable; skipping failover"
        exit 0
        ;;
    stopped|unreachable)
        reason="${ssh_container_status}"
        ;;
    *)
        log "Unexpected status '${ssh_container_status}'; skipping failover"
        exit 0
        ;;
esac

log "Triggering failover: primary=${reason}"

# Start Home Assistant on the standby
failover_time=$(date '+%Y-%m-%d %H:%M:%S %Z')
if docker compose -f "${COMPOSE_DIR}/compose.yml" up -d homeassistant; then
    log "Failover succeeded: homeassistant started on ${hostname_local}"
    failover_status="SUCCESS"
else
    log "Failover failed: could not start homeassistant on ${hostname_local}"
    failover_status="FAILED"
fi

# After the container, so the name is only moved to something that can answer.
if "${NAME_SWITCH}" standby; then
    name_status="now points here"
else
    name_status="NOT moved, still points at the primary"
fi

send_mail \
    "[ALERT] Home Assistant Failover: ${PRIMARY_HOST} -> ${hostname_local}" \
    "$(cat <<EOF
Home Assistant failover was triggered.

Failover time : ${failover_time}
Primary host  : ${PRIMARY_HOST}
Standby host  : ${hostname_local}
Reason        : Primary container is ${reason}, unreachable for ${elapsed}s
Result        : ${failover_status}
Name          : ${DOMAIN} ${name_status}

Current status on standby:
$(docker ps --filter name=homeassistant --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}')

Nothing has to be done to go back. Once ${PRIMARY_HOST} answers again, its own
container starts with the host, the name moves back and this one stops itself
within 5 minutes, which discards the configuration changes made here meanwhile.

To keep serving from ${hostname_local} regardless, create ${HOLD_FILE}.
To carry this host's configuration over to ${PRIMARY_HOST} instead of losing it,
run 'sudo homeassistant-failback' before that happens.

Investigate the cause on ${PRIMARY_HOST}.

--
${LOG_TAG} on ${hostname_local}
EOF
)"

exit 0
