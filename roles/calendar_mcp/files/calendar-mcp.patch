diff --git a/src/CalendarMcp.Core/Tools/SaveDraftTool.cs b/src/CalendarMcp.Core/Tools/SaveDraftTool.cs
new file mode 100644
index 0000000..52d92cb
--- /dev/null
+++ b/src/CalendarMcp.Core/Tools/SaveDraftTool.cs
@@ -0,0 +1,68 @@
+using System.ComponentModel;
+using System.Text.Json;
+using CalendarMcp.Core.Models;
+using CalendarMcp.Core.Services;
+using Microsoft.Extensions.Logging;
+using ModelContextProtocol;
+using ModelContextProtocol.Server;
+
+namespace CalendarMcp.Core.Tools;
+
+/// <summary>
+/// MCP tool for saving a draft to the account's drafts folder. It never sends, so it
+/// needs only the permission to manage the mailbox.
+/// </summary>
+[McpServerToolType]
+public sealed class SaveDraftTool(
+    IAccountRegistry accountRegistry,
+    IProviderServiceFactory providerFactory,
+    ILogger<SaveDraftTool> logger)
+{
+    [McpServerTool, Description("Save an email as a draft in the account's drafts folder (IMAP). The draft is not sent; the account owner sends it from their mail client. To draft a reply, pass the original's email ID as inReplyToEmailId.")]
+    public async Task<string> SaveDraft(
+        [Description("Account ID that owns the drafts folder. Obtain from list_accounts.")] string accountId,
+        [Description("Recipient email address(es). Supply as a JSON array of strings, e.g. [\"alice@example.com\"].")] List<string> to,
+        [Description("Email subject line")] string subject,
+        [Description("Email body content. Use HTML when bodyFormat is 'html' (the default).")] string body = "",
+        [Description("Body content format: 'html' (default) or 'text'.")] string bodyFormat = "html",
+        [Description("CC recipient email addresses")] List<string>? cc = null,
+        [Description("Email ID of the message being replied to. Obtain from the id field returned by get_emails or search_emails. Sets In-Reply-To and References.")] string? inReplyToEmailId = null)
+    {
+        logger.LogInformation("Saving draft: accountId={AccountId}, inReplyTo={InReplyTo}",
+            accountId, inReplyToEmailId);
+
+        ToolGuard.RequireNonEmpty(accountId, nameof(accountId));
+        if (to is not { Count: > 0 })
+            throw new McpException("At least one recipient is required in 'to'.");
+        var account = await ToolGuard.RequireAccountAsync(
+            accountRegistry, accountId, AccountPermission.EmailRead);
+
+        try
+        {
+            var provider = providerFactory.GetProvider(account.Provider);
+            var draftEmailId = await provider.SaveDraftAsync(
+                accountId, string.Join(", ", to), subject, body, bodyFormat, cc, inReplyToEmailId,
+                CancellationToken.None);
+
+            var response = new
+            {
+                success = true,
+                accountId = accountId,
+                draftEmailId = draftEmailId,
+                message = $"Draft saved in account '{accountId}'. It was not sent."
+            };
+
+            logger.LogInformation("Saved draft {DraftEmailId} in account {AccountId}", draftEmailId, accountId);
+
+            return JsonSerializer.Serialize(response, new JsonSerializerOptions
+            {
+                WriteIndented = true
+            });
+        }
+        catch (Exception ex) when (ex is not McpException)
+        {
+            logger.LogError(ex, "Error in save_draft tool");
+            throw ToolGuard.Failure("save draft", ex);
+        }
+    }
+}
