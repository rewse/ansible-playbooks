+    [TestMethod]
+    public void ToEmailHeaders_KeepsEveryFieldInOrder()
+    {
+        var headers = new MimeKit.HeaderList
+        {
+            { "Received", "from a" },
+            { "Received", "from b" },
+            { "ARC-Authentication-Results", "i=1; rewse.jp; spf=pass" },
