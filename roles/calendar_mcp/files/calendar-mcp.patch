+    public async Task<string?> SaveDraftAsync(
+        string accountId, string to, string subject, string body,
+        string bodyFormat = "html", List<string>? cc = null, string? inReplyToEmailId = null,
+        CancellationToken cancellationToken = default)
+    {
+        var cfg = await ResolveConfigAsync(accountId);
+
+        return await WithImapAsync<string?>(cfg, async client =>
+        {
+            string? inReplyTo = null;
+            List<string>? references = null;
+            if (!string.IsNullOrWhiteSpace(inReplyToEmailId))
+            {
+                var (folderName, uidValidity, uid) = ParseEmailId(inReplyToEmailId);
+                var source = await OpenFolderAsync(client, folderName, FolderAccess.ReadOnly, cancellationToken);
+                EnsureUidValidity(source, uidValidity, accountId, folderName);
+                var summary = (await source.FetchAsync(
+                    new[] { new UniqueId(uid) },
+                    MessageSummaryItems.Envelope | MessageSummaryItems.References,
+                    cancellationToken)).FirstOrDefault()
+                    ?? throw new ProviderOperationException(
+                        $"Email '{inReplyToEmailId}' was not found on IMAP account '{accountId}'.");
+                inReplyTo = summary.Envelope?.MessageId;
+                references = summary.References?.ToList() ?? new List<string>();
+                if (!string.IsNullOrEmpty(inReplyTo))
+                    references.Add(inReplyTo);
+            }
+
+            var message = BuildDraftMessage(
+                cfg.Username, to, cc, subject, body, bodyFormat, inReplyTo, references);
+
+            var drafts = await ResolveFolderAsync(client, cfg, "drafts", cancellationToken);
+            await drafts.OpenAsync(FolderAccess.ReadWrite, cancellationToken);
+            var appended = await drafts.AppendAsync(
+                message, MessageFlags.Draft | MessageFlags.Seen, cancellationToken);
+
+            // The UID is only known when the server supports UIDPLUS (APPENDUID).
+            return appended is { } id && drafts.UidValidity > 0
+                ? FormatEmailId(drafts.FullName, drafts.UidValidity, id.Id)
+                : null;
+        }, cancellationToken);
+    }
+
+    /// <summary>
+    /// Builds the message <see cref="SaveDraftAsync"/> stores. Kept apart from
+    /// <c>SendEmailAsync</c>, which a draft never goes through.
+    /// </summary>
+    internal static MimeMessage BuildDraftMessage(
+        string from, string to, List<string>? cc, string subject, string body,
+        string bodyFormat, string? inReplyToMessageId, IEnumerable<string>? references)
+    {
+        var message = new MimeMessage();
+        message.From.Add(MailboxAddress.Parse(from));
+        foreach (var addr in SplitAddresses(to))
+            message.To.Add(MailboxAddress.Parse(addr));
+        if (cc is { Count: > 0 })
+        {
+            foreach (var addr in cc)
+                message.Cc.Add(MailboxAddress.Parse(addr));
+        }
+        message.Subject = subject;
+        if (!string.IsNullOrEmpty(inReplyToMessageId))
+            message.InReplyTo = inReplyToMessageId;
+        if (references is not null)
+        {
+            foreach (var reference in references)
+                message.References.Add(reference);
+        }
+        message.Body = new TextPart(
+            bodyFormat.Equals("text", StringComparison.OrdinalIgnoreCase) ? TextFormat.Plain : TextFormat.Html)
+        { Text = body };
+        return message;
+    }
