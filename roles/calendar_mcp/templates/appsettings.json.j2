{{ ansible_managed | comment('c') }}
{
  "CalendarMcp": {
    "ExternalBaseUrl": {{ ('https://' ~ calendar_mcp_hostname ~ '/mcp/' ~ account.name) | to_json }},
    "Accounts": [
      {
        "Id": {{ (account.name ~ '-sakura') | to_json }},
        "DisplayName": "Sakura",
        "Provider": "imap",
        "Enabled": true,
        "Priority": 1,
        "Domains": [],
        "Permissions": {
          "emailRead": true,
          "emailSend": false,
          "calendarRead": false,
          "calendarWrite": false,
          "contactsRead": false,
          "contactsWrite": false
        },
        "ProviderConfig": {
          "imapHost": "rewse.sakura.ne.jp",
          "imapPort": "993",
          "smtpHost": "smtp.invalid",
          "username": {{ account.address | to_json }},
          "password": {{ account.sakura_password | to_json }},
          "inboxFolder": "INBOX",
          "sentFolder": {{ calendar_mcp_sakura_folders.sent | to_json }},
          "trashFolder": {{ calendar_mcp_sakura_folders.trash | to_json }},
          "junkFolder": {{ calendar_mcp_sakura_folders.junk | to_json }},
          "draftsFolder": {{ calendar_mcp_sakura_folders.drafts | to_json }}
        }
      },
      {
        "Id": {{ (account.name ~ '-icloud') | to_json }},
        "DisplayName": "iCloud",
        "Provider": "dav",
        "Enabled": true,
        "Priority": 2,
        "Domains": [],
        "Permissions": {
          "emailRead": false,
          "emailSend": false,
          "calendarRead": true,
          "calendarWrite": true,
          "contactsRead": true,
          "contactsWrite": true
        },
        "ProviderConfig": {
          "preset": "icloud",
          "username": {{ account.apple_id | to_json }},
          "password": {{ account.apple_password | to_json }},
          "enableCalendar": "true",
          "enableContacts": "true"
        }
      }
    ]
  }
}
