#!/bin/bash
[% ansible_managed | comment %]
set -euo pipefail

# The configuration carries secrets.yaml and is readable only by root on the
# primary, so the pull logs in over SSH and reads it through sudo.
SOURCE="[% admin_user %]@fox.rewse.jp:/srv/homeassistant/config/"
DEST="/srv/homeassistant/config/"
LOG_TAG="homeassistant-sync"

# Skip sync when local Home Assistant is running (failover active)
if docker ps --format '{{.Names}}' | grep -q '^homeassistant$'; then
    logger -t "${LOG_TAG}" "Local Home Assistant is running (failover active); skipping sync"
    exit 0
fi

rsync \
    --archive \
    --delete \
    --rsync-path="sudo rsync" \
    -e "ssh -p 11022 -o BatchMode=yes -o ConnectTimeout=10 -o StrictHostKeyChecking=accept-new" \
    --exclude='*.log*' \
    --exclude='home-assistant_v2.db*' \
    --exclude='*.db-shm' \
    --exclude='*.db-wal' \
    --exclude='.cache/' \
    --exclude='.ha_run.lock' \
    --exclude='backups/' \
    --exclude='tmp_backups/' \
    --exclude='tts/' \
    --exclude='deps/' \
    --exclude='__pycache__/' \
    "${SOURCE}" \
    "${DEST}"
