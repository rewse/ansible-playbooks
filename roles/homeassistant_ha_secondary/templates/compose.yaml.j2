{{ ansible_managed | comment }}
name: homeassistant

services:
  homeassistant:
    container_name: homeassistant
    image: {{ __homeassistant_ha_secondary_image.ref }}
    # Bluetooth adapter recovery and raw advertisements need these on top of
    # Docker's default set; BlueZ itself is reached over D-Bus.
    cap_add:
      - NET_ADMIN
      - NET_RAW
    volumes:
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
      - /srv/homeassistant/config:/config
    security_opt:
      - apparmor:unconfined
    network_mode: host
    restart: "no"
