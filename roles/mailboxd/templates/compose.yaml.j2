{{ ansible_managed | comment }}
name: mailboxd

services:
  mailboxd:
    container_name: mailboxd
    image: {{ __mailboxd_image.ref }}
    # Reached only through the Apache vhost, which terminates TLS and is the only
    # place a client can arrive from.
    ports:
      - "127.0.0.1:{{ mailboxd_port }}:8000"
    environment:
      WORKERS: 2
      MAILBOXD_CONFIG: /etc/mailboxd/config.yaml
      MAILBOXD_STATE_PATH: /var/lib/mailboxd/state.db
    # Raw, because Compose otherwise interpolates $ in the values and a
    # password containing one would arrive changed.
    env_file:
      - path: .env
        format: raw
    volumes:
      - /etc/compose/mailboxd/config.yaml:/etc/mailboxd/config.yaml:ro
      - {{ mailboxd_data_dir }}:/var/lib/mailboxd
    # The hardening of the upstream docker-compose.yml. The service holds the
    # IMAP passwords of every mailbox, so it keeps no capability and cannot
    # write outside its state directory.
    init: true
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    read_only: true
    tmpfs:
      - /tmp:size=64m,noexec,nosuid
    mem_limit: 512m
    cpus: 1
    pids_limit: 256
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "5"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health').status==200 else 1)"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 30s
    restart: unless-stopped
