{{ ansible_managed | comment }}
<VirtualHost *:443>
    ServerAdmin hostmaster@rewse.jp
    ServerName {{ mailboxd_hostname }}

    ProxyPreserveHost on
    ProxyRequests off

    # Streamable HTTP can answer a call as server-sent events, which reach the
    # client only as Apache flushes them. 127.0.0.1 rather than localhost, which
    # resolves to ::1 first while the container publishes on IPv4 loopback only.
    ProxyPass / http://127.0.0.1:{{ mailboxd_port }}/ flushpackets=on
    ProxyPassReverse / http://127.0.0.1:{{ mailboxd_port }}/

    # Open to every address. Muse connects from Meta's cloud, whose addresses
    # are not published, so the bearer token, the fail2ban jail, and the WAF in
    # front of CloudFront are what protect the mailboxes.
    #
    # Only the MCP endpoint and the health check are published. mailboxd also
    # serves a REST API that answers a wrong token with 401 on every path, and
    # the jail counts 401s on /mcp only, so a guess against any other path
    # would never be banned. Muse uses MCP alone.
    <LocationMatch "^/(?!(mcp(/.*)?|health)$)">
        Require all denied
    </LocationMatch>

    SSLCertificateFile /etc/letsencrypt/live/rewse.jp/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/rewse.jp/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
