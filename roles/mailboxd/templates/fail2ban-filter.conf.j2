{{ ansible_managed | comment }}
#
# The server answers a missing or wrong bearer token on every path but /health
# with 401. Only the MCP endpoint is matched: an MCP client may read the OAuth
# metadata under /.well-known before it sends a token, and that must not count
# against it.
#
# The virtual host is pinned because other_vhosts_access.log carries every name
# Apache serves, and the vhost_combined format puts %v:%p ahead of the client
# address, which is why <HOST> is the second field rather than the first.
[Definition]
failregex = ^{{ mailboxd_hostname | regex_escape }}:\d+ <HOST> \S+ \S+ \[\] "\S+ /mcp(?:[/?]\S*)? HTTP/[\d.]+" 401 \d+
ignoreregex =
