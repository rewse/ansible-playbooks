{{ ansible_managed | comment }}
#
# Home Assistant writes the failed logins itself, at a path that does not move,
# so this one reads the application log. The standby enables it only once the
# synced log exists there.
#
# backend is stated because jail.d/defaults-debian.conf from the package sets
# systemd for every jail and jail.d is read after jail.local. Without it the jail
# reads the journal and watches no file, while fail2ban-client status still
# reports it enabled; get <jail> logpath is what tells the two apart.
#
# The address banned here is the one Home Assistant logged, which is the client's
# only while Apache is a trusted proxy. Those proxies are listed in the UI under
# Settings > System > Network, and an Apache address missing from them makes this
# jail ban the proxy itself.
[homeassistant]
enabled = {{ 'true' if homeassistant_fail2ban_enabled | default(true) else 'false' }}
backend = auto
port = http,https
filter = homeassistant
logpath = /srv/homeassistant/config/home-assistant.log
