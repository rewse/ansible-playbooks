[% ansible_managed | comment %]
# curl reads the TV's credentials from regza.netrc, keeping them off its command
# line, which any user on the host can read.
control_toggle_regza: >-
    curl -k --digest --netrc-file /config/regza.netrc \
    https://regza.rewse.jp:4430/remote/remote.htm?key=40BF12
control_volume_up_regza: >-
    curl -k --digest --netrc-file /config/regza.netrc \
    https://regza.rewse.jp:4430/remote/remote.htm?key=40BF1A
control_volume_down_regza: >-
    curl -k --digest --netrc-file /config/regza.netrc \
    https://regza.rewse.jp:4430/remote/remote.htm?key=40BF1E
control_mute_regza: >-
    curl -k --digest --netrc-file /config/regza.netrc \
    https://regza.rewse.jp:4430/remote/remote.htm?key=40BF10
