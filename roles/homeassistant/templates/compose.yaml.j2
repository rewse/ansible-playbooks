{{ ansible_managed | comment }}
name: homeassistant

services:
  homeassistant:
    container_name: homeassistant
    image: {{ __homeassistant_image.ref }}
    # Bluetooth adapter recovery and raw advertisements need these on top of
    # Docker's default set; BlueZ itself is reached over D-Bus.
    cap_add:
      - NET_ADMIN
      - NET_RAW
    # The Zigbee dongle used by ZHA.
    devices:
      - /dev/ttyUSB0:/dev/ttyUSB0
    volumes:
      - /dev/serial/by-id:/dev/serial/by-id
      - /etc/localtime:/etc/localtime:ro
      - /run/dbus:/run/dbus:ro
      - /srv/homeassistant/config:/config
    security_opt:
      - apparmor:unconfined
    network_mode: host
    restart: unless-stopped
