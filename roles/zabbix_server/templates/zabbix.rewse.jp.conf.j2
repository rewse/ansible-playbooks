{{ ansible_managed | comment }}
#
# The Zabbix frontend and API for clients away from home, such as IntelliTrend
# Mobile on a cellular network. The Alias in the package's zabbix.conf applies
# to every virtual host, so this host only has to open /zabbix.
#
# Apache merges the <Location> sections of a virtual host after those of the
# server, so this block overrides the Require ip lines in zabbix-api.conf for
# this name only, the API included. rewse.jp and the other names that reach the
# default virtual host keep those limits.
#
# The API cannot be protected here: a failed login answers 200, so fail2ban
# has nothing to match, and it takes no MFA. Zabbix roles protect it instead.
# Admin's role has no API access, and the account the app uses may only call
# get methods.
<VirtualHost *:443>
    ServerAdmin hostmaster@rewse.jp
    ServerName {{ zabbix_server_hostname }}

    RedirectMatch ^/$ /zabbix/

    <Location "/zabbix">
        Require all granted
    </Location>

    SSLCertificateFile /etc/letsencrypt/live/rewse.jp/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/rewse.jp/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
