{# {{ ansible_managed }} #}
# The API answers a wrong credential with 200, the JSON-RPC error sitting in the
# body, so a failed login cannot be told from a successful one by status and
# fail2ban has nothing to match on. The frontend's own login is a different matter
# and is covered by the zabbix-web jail, which reads the 200 that a re-rendered
# login form returns.
#
# Scanners find this path. The access log holds probes from three addresses that
# also swept for SugarCRM, iLO and Oracle IDM URLs.
#
# These limits apply to every name that reaches the default virtual host, such
# as rewse.jp, which the MCP server on this host calls the API through.
# zabbix.rewse.jp has its own virtual host that opens the frontend and the API
# to the internet, because IntelliTrend Mobile calls the API from cellular
# networks. There the API is protected by Zabbix roles, which leave Admin
# without API access and let the app's account call only get methods, and by
# the WAF's rate limit in front of CloudFront.
#
# Location rather than Directory, because zabbix.conf from the package grants the
# frontend through a Directory block and Location is merged after Directory
# whichever order the files load in.
#
# On these names the frontend is used from home and the office only, so the
# login page is not offered to anyone else. Apache applies Location blocks in
# file order, so the narrower API block has to follow this one to override it.
#
# Zabbix reads the login fields from $_REQUEST, so a query string logs in as a
# form post does, but the zabbix-web filter counts only POST. The <If> refuses
# any other method on the login pages when the query string names enter or
# password; Zabbix logs in only when enter is present. Apache merges <If> after
# the Require lines of its <Location>, so its Require all denied replaces them.
# REQUEST_URI is the decoded, normalized path Apache maps, and PHP's path info
# reaches the same script. The query string is matched as sent, because PHP
# splits it on & and = before decoding: each letter may be percent-encoded and
# anything may precede the field name in its pair, such as + or a decoded
# space. unescape() would return the string unchanged on any malformed escape.
# zabbix.rewse.jp repeats the rule inside its own <Location>.
<Location "/zabbix">
    Require ip 127.0.0.1
    Require ip ::1
    Require ip {{ networks.home_private_ipv4 }}
    Require ip {{ networks.home_public_ipv4 }}
    Require ip {{ networks.home_public_ipv6 }}
    Require ip {{ networks.home_private_ipv6 }}
    Require ip {{ networks.office_public_ipv4 | join(' ') }}
    <If "%{REQUEST_METHOD} != 'POST' && %{REQUEST_URI} =~ m#^/zabbix(/(index(_mfa)?\.php(/.*)?)?)?$# && %{QUERY_STRING} =~ /(^|&)[^&=]*((e|%65)(n|%6e)(t|%74)(e|%65)(r|%72)|(p|%70)(a|%61)(s|%73)(s|%73)(w|%77)(o|%6f)(r|%72)(d|%64))/i">
        Require all denied
    </If>
</Location>

<Location "/zabbix/api_jsonrpc.php">
    Require ip 127.0.0.1
    Require ip ::1
    Require ip {{ networks.home_private_ipv4 }}
    Require ip {{ networks.home_public_ipv6 }}
    Require ip {{ networks.home_private_ipv6 }}
</Location>
