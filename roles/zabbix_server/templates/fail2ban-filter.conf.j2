{{ ansible_managed | comment }}
#
# The status code is what separates a failure from a success, not 401: Zabbix
# answers both with 200 or 302 over the same URL. A wrong password re-renders the
# login form as 200, and a correct one redirects, 302, to the MFA step. The MFA
# step behaves the same way, so a wrong verification code is a 200 on
# index_mfa.php. Matching both catches the six-digit code as well as the password.
#
# Nothing else posts to either path, so no legitimate request is at risk: across
# the retained logs the only entries are from testing this filter.
#
# The first pattern reads Apache's access.log, where the default virtual host
# serves /zabbix to trusted networks. That file is combined format, so <HOST> is
# the first field. The second reads other_vhosts_access.log, where the virtual
# host open to the internet logs in vhost_combined format: %v:%p comes first and
# <HOST> second, and the name is pinned because that file carries every virtual
# host.
#
# The path is matched in %U, the last field of both formats, rather than in the
# request line. Apache routes by that decoded path, so a query string, repeated
# slashes, dot segments, or percent-encoded characters in the request line reach
# the same script and still log it as /zabbix/index.php. The end anchor keeps a
# quoted value in the user agent from standing in for it.
[Definition]
failregex = ^<HOST> \S+ \S+ \[\] "POST \S+ HTTP/[\d.]+" 200 \d+ .* "/+zabbix/+index(?:_mfa)?\.php"$
            ^{{ zabbix_server_hostname | regex_escape }}:\d+ <HOST> \S+ \S+ \[\] "POST \S+ HTTP/[\d.]+" 200 \d+ .* "/+zabbix/+index(?:_mfa)?\.php"$
ignoreregex =
