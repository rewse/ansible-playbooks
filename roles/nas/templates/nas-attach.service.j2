[Unit]
Description=Bring the enclosure volumes back into service
Documentation=file:/usr/local/sbin/nas-attach
# udev unlocks and mounts the volumes, and nothing else follows on its own: the
# restic timers and the services nas-detach stopped stay stopped, and Docker
# resolves a bind source when the container starts, refuses to start while one is
# missing and applies no restart policy to a container that failed to start. So a
# boot without the enclosure, or a run of nas-detach, leaves the shares, the
# backups and the containers down once the volumes arrive. This is what brings
# them back, through the same script that does it by hand.
#
# The volumes arrive together, the enclosure carrying a single power switch, so
# whichever mount is last to appear is the one that finds every condition met;
# the earlier ones skip on the conditions and cost nothing.
Requires=docker.service
After=docker.service
{% for volume in nas_volumes | sort(attribute='path') %}
After={{ volume.path | regex_replace('^/', '') | regex_replace('/', '-') }}.mount
{% endfor %}
{% for volume in nas_volumes | sort(attribute='path') %}
ConditionPathIsMountPoint={{ volume.path }}
{% endfor %}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/nas-attach

[Install]
{% for volume in nas_volumes | sort(attribute='path') %}
WantedBy={{ volume.path | regex_replace('^/', '') | regex_replace('/', '-') }}.mount
{% endfor %}
