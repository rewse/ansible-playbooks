#!/usr/bin/bash
# {{ ansible_managed }}
#
# One repository per invocation, named by the argument. The unit is templated on
# the same name and carries the repository and credentials in its environment.
set -euo pipefail

readonly NAME="${1:?usage: nas-backup-s3 <repository>}"

case "${NAME}" in
{% for repo in nas_s3_repositories %}
  {{ repo.name }}) readonly SRC="{{ repo.source }}" ;;
{% endfor %}
  *) echo "Error: unknown repository ${NAME}" >&2; exit 1 ;;
esac

# Initialize repository on first run
if ! restic cat config > /dev/null 2>&1; then
  restic init
fi

# The pack size comes from the unit as RESTIC_PACK_SIZE, so it also applies to
# the repacking prune does below. Passing it as a flag here would leave prune
# building packs at the 16 MiB default.
nice -n 10 restic backup "${SRC}" \
  --verbose \
  --tag daily

# The same policy the local repositories use, so a snapshot found in one has a
# counterpart in the other and there is one retention rule to reason about.
#
# prune only rewrites packs that deletions left partly unused, so it normally
# transfers nothing. When it does have work, note that archive/data reaches
# Glacier Instant Retrieval after a day and reads there are billed.
nice -n 10 restic forget \
  --keep-daily 30 \
  --keep-weekly 8 \
  --keep-monthly 12 \
  --prune

# Mark successful completion for monitoring
touch "/var/lib/nas-backup-s3-${NAME}.success"
