[Unit]
Description=Daily offsite backup of %i to S3
After=network-online.target
Wants=network-online.target
OnFailure=failure-notify@%n.service
# The sources are volumes in the enclosure and crypttab uses nofail, so a boot
# can complete without them. Without this a run would record an empty directory
# and report success, and the retention policy would then age out the real
# snapshots.
RequiresMountsFor={{ nas_s3_repositories | map(attribute='source') | join(' ') }}

[Service]
Type=oneshot
Environment=RESTIC_REPOSITORY=s3:s3.{{ nas_s3_region }}.amazonaws.com/{{ nas_s3_bucket }}/%i
Environment=RESTIC_PASSWORD_FILE=/etc/restic/password
# Set here rather than as a flag so every restic command in the script uses it.
# The documented cost is temporary space of pack size times connections plus one,
# which lands in /tmp on the root filesystem.
Environment=RESTIC_PACK_SIZE={{ nas_restic_pack_size }}
Environment=RESTIC_PROGRESS_FPS=0.0166
Environment=XDG_CACHE_HOME=/var/cache/restic
# The access key lives here rather than in this unit, which is world readable.
EnvironmentFile=/etc/restic/s3.env
ExecStart=/usr/local/sbin/nas-backup-s3 %i
