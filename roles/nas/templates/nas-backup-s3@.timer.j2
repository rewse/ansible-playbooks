[Unit]
Description=Daily offsite backup of %i to S3 timer

[Timer]
# After the local backups at 04:00, so a day's snapshots are consistent with each
# other, and spread apart because the first archive run takes days and holds the
# uplink. systemd skips a trigger while the instance is still running.
OnCalendar=*-*-* 05:30:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
