#!/bin/bash
set -euo pipefail

readonly OUTPUT=/srv/homeassistant/config/data/enecoq_data.json

# The cooldown that supply_chain_cooldown_environment gives playbook tasks. This
# runs from a timer, and @latest resolves again on every run, so the cutoff is
# computed here each time. It holds back the third-party dependencies, such as
# playwright; the package itself is this account's own and is adopted on release.
UV_EXCLUDE_NEWER="$(date -u -d '[% supply_chain_cooldown_days %] days ago' +%Y-%m-%dT%H:%M:%SZ)"
export UV_EXCLUDE_NEWER
OWN_PACKAGE="enecoq-data-fetcher=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
readonly OWN_PACKAGE

fetch() {
  uvx --exclude-newer-package "$OWN_PACKAGE" enecoq-data-fetcher@latest \
    --email '[% enecoq_data_fetcher_enecoq.email %]' \
    --password '[% enecoq_data_fetcher_enecoq.password %]' \
    --period month \
    --format json \
    --output "$OUTPUT"
}

# The enecoQ widget serves no data until around 01:40 on the 1st of the month
# while the previous month is being closed
in_rollover_window() {
  local day hour minute

  day=$(date +%-d)
  hour=$(date +%-H)
  minute=$(date +%-M)

  if [[ $day -eq 1 && ($hour -eq 0 || ($hour -eq 1 && $minute -lt 40)) ]]; then
    return 0
  fi

  return 1
}

sleep $((RANDOM % 60))

if fetch; then
  exit 0
fi

# A playwright update leaves its browser behind, so reinstall and retry
uvx --exclude-newer-package "$OWN_PACKAGE" --from enecoq-data-fetcher@latest \
  playwright install chromium

if fetch; then
  exit 0
fi

if in_rollover_window; then
  echo "enecoQ data is unavailable during the monthly rollover window" >&2
  exit 0
fi

exit 1
