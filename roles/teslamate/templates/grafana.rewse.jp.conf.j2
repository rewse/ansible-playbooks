# {{ ansible_managed }}
<VirtualHost *:443>
    ServerAdmin hostmaster@rewse.jp
    ServerName {{ teslamate_grafana_hostname }}

    SSLEngine on

    ProxyPreserveHost on
    ProxyRequests off
    RequestHeader set X-Forwarded-Proto "https"

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"

    # These sections run at authorization, after Apache has decoded the path,
    # merged repeated slashes, and mapped the request to the proxy, so neither
    # the spelling of the path nor the order of translation affects them. Each
    # only denies; a grant here would replace the server-wide Require lines.
    #
    # Grafana signs out and switches the organization on GET, and its session
    # cookie is SameSite=Lax, so a link on another site would act for the user.
    # Browsers mark such a navigation with Sec-Fetch-Site. A bookmark, a link
    # inside Grafana, and a client that sends no header pass.
    <If "%{REQUEST_URI} =~ m#^/(logout|profile/switch-org)(/|$)#i && req('Sec-Fetch-Site') in {'cross-site', 'same-site'}">
        Require all denied
    </If>
    # SMTP is not configured, so a password reset cannot complete, and its
    # endpoints only reveal whether a login exists.
    <If "%{REQUEST_URI} =~ m#^/(api/)?user/password/(reset|send-reset-email)(/|$)#i">
        Require all denied
    </If>
    # Dashboards use base_url and the pg_stat_statements_* variables unescaped,
    # so a dashboard URL that sets them as var-<name> is refused. Grafana writes
    # every variable without skipUrlSync, hidden ones included, into the URL of
    # the dashboard on screen, so a bookmark can carry base_url set to
    # TeslaMate's URL, and a base_url with exactly that value passes. The
    # pg_stat_statements_* values are SQL, so none of them passes. The browser
    # splits the query string on & and decodes each name, so every character of
    # a name may arrive percent-encoded. The raw string is matched because
    # unescape() returns its input unchanged when any escape in it is malformed.
    <If "%{QUERY_STRING} =~ m#(^|&)(v|%76)(a|%61)(r|%72)(-|%2d)((b|%62)(a|%61)(s|%73)(e|%65)(_|%5f)(u|%75)(r|%72)(l|%6c)(?!=https(:|%3a)(/|%2f)(/|%2f){{ teslamate_hostname | replace('.', '[.]') }}(&|$))(=|&|$)|(p|%70)(g|%67)(_|%5f)(s|%73)(t|%74)(a|%61)(t|%74)(_|%5f)(s|%73)(t|%74)(a|%61)(t|%74)(e|%65)(m|%6d)(e|%65)(n|%6e)(t|%74)(s|%73)(_|%5f))#i">
        Require all denied
    </If>

    ProxyPass /api/live/ws ws://127.0.0.1:{{ teslamate_grafana_port }}/api/live/ws
    ProxyPassReverse /api/live/ws ws://127.0.0.1:{{ teslamate_grafana_port }}/api/live/ws
    ProxyPass / http://127.0.0.1:{{ teslamate_grafana_port }}/
    ProxyPassReverse / http://127.0.0.1:{{ teslamate_grafana_port }}/

    # Grafana answers an expired session with 401 as well, so a failed basic-auth
    # request is recognised by a separate log of the requests that carry one; the
    # fail2ban jail reads it. Only the request line is logged, not the header.
    # A CustomLog here stops the vhost inheriting the server's, so the shared
    # access log is named again. The entry is stamped with the time the response
    # finished, as the httpd role does for the shared formats. The pentest log of
    # the httpd role is named again for the same reason, with the format the
    # httpd role defines. The auth scheme is
    # case-insensitive, so the header is matched in any case.
    SetEnvIfNoCase Authorization "^Basic " grafana_basic_auth
    CustomLog ${APACHE_LOG_DIR}/other_vhosts_access.log vhost_combined
    CustomLog ${APACHE_LOG_DIR}/grafana_basic_auth.log "%v:%p %a basic %{end:[%d/%b/%Y:%H:%M:%S %z]}t \"%r\" %>s %O" env=grafana_basic_auth
    CustomLog ${APACHE_LOG_DIR}/security_agent_pentest.log security_agent_pentest env=security_agent_pentest

    SSLCertificateFile /etc/letsencrypt/live/rewse.jp/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/rewse.jp/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
