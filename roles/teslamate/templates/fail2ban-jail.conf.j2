{{ ansible_managed | comment }}
#
# backend is stated because jail.d/defaults-debian.conf from the package sets
# systemd for every jail and jail.d is read after jail.local.
[teslamate]
enabled = true
backend = auto
port = http,https
# The firewall stops direct connections, and apache-deny stops requests that
# arrive through CloudFront, whose edge servers the firewall cannot single out.
action = %(action_)s
         apache-deny
filter = teslamate
logpath = /var/log/apache2/other_vhosts_access.log
          /var/log/apache2/grafana_basic_auth.log
