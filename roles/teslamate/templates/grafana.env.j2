DATABASE_HOST={{ teslamate_database_tls_host | replace('$', '$$') | to_json }}
DATABASE_NAME={{ teslamate_database_name | replace('$', '$$') | to_json }}
DATABASE_PASS={{ teslamate_grafana_database_password | replace('$', '$$') | to_json }}
DATABASE_PORT={{ teslamate_database_port }}
DATABASE_SSL_MODE=require
DATABASE_USER={{ teslamate_grafana_database_username | replace('$', '$$') | to_json }}
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_BASIC_ENABLED=true
# The car browser signs in as a Viewer and is tedious to type a password on, so
# sessions last ten years; revoke one by deleting its user_auth_token row.
GF_AUTH_LOGIN_MAXIMUM_INACTIVE_LIFETIME_DURATION=120M
GF_AUTH_LOGIN_MAXIMUM_LIFETIME_DURATION=120M
GF_SECURITY_ADMIN_PASSWORD={{ teslamate_grafana_admin_password | replace('$', '$$') | to_json }}
GF_SECURITY_ADMIN_USER={{ teslamate_grafana_admin_username | replace('$', '$$') | to_json }}
# Apache terminates TLS, so Grafana cannot tell that the session cookie should
# stay off plain HTTP; a ten-year session leaked over http:// stays usable.
GF_SECURITY_COOKIE_SECURE=true
GF_SERVER_ROOT_URL=https://{{ teslamate_grafana_hostname }}
GRAFANA_PASSWD={{ teslamate_grafana_admin_password | replace('$', '$$') | to_json }}
