#!/bin/bash

# wlan0 holds a second static address on the same segment as eth0 as a path of
# last resort, and only one of the two may carry that segment at a time: Avahi
# that meets its own records while probing takes them for another host and
# renames itself, which strands every saved Time Machine destination.
#
# Reached from the networkd-dispatcher hooks, which react to a carrier change as
# it happens, and from a timer that covers what no event reports. Neither tells
# this which interface moved, so it reconciles the whole state every time and a
# second run does nothing the first did not.

set -u

readonly gateway="{{ raspberrypi_default_gateway }}"

# Consecutive probe failures before the fallback takes the segment. A carrier
# that is gone is acted on at once, being a hardware fact, but a probe that
# fails while the carrier holds is not trusted on its own: one lost packet is
# enough to fail it, and that is a normal event at the minute a nightly backup
# starts.
readonly failures_required=2
readonly failure_count=/run/network-failover.failures

is_admin_up() {
    (( $(cat "/sys/class/net/$1/flags" 2> /dev/null || echo 0) & 0x1 ))
}

# Reading this fails outright on a link that is administratively down, which is
# indistinguishable from a link without carrier for the purpose here.
has_carrier() {
    [[ "$(cat "/sys/class/net/$1/carrier" 2> /dev/null || echo 0)" == 1 ]]
}

# Three packets, any one of which is an answer. The gateway replies in under a
# millisecond on an idle host and in tens of milliseconds while a backup
# saturates the uplink.
reaches_gateway() {
    ping -c 3 -i 0.3 -W 1 -I eth0 "$gateway" &> /dev/null
}

count_failure() {
    local count=$(( $(cat "$failure_count" 2> /dev/null || echo 0) + 1 ))

    echo "$count" > "$failure_count"

    (( count >= failures_required ))
}

# Both tables describe paths through the interface that just stopped carrying
# the segment, and a stale entry outlives the switch by minutes.
reset_paths() {
    ip neigh flush all
    conntrack -F 2> /dev/null || true
}

restore_primary() {
    rm -f "$failure_count"

    is_admin_up wlan0 || return 0

    logger -t network-failover "eth0 reaches $gateway, bringing wlan0 down"
    ip link set wlan0 down
    reset_paths
}

activate_fallback() {
    is_admin_up wlan0 && return 0

    logger -t network-failover "eth0 cannot reach $gateway, bringing wlan0 up"
    ip link set wlan0 up
    reset_paths
}

# A dispatcher hook fires for every link the host has, including the veths that
# come and go with containers.
case "${IFACE:-}" in
    eth0 | wlan0 | "") ;;
    *) exit 0 ;;
esac

if has_carrier eth0 && reaches_gateway; then
    restore_primary
elif has_carrier eth0 && ! count_failure; then
    exit 0
else
    activate_fallback
fi
