#!/usr/bin/bash
# {{ ansible_managed }}
{#
  The repository lives on Bay 2 of the enclosure attached to the NAS host. That
  host reaches it as a local directory, every other host mounts it over NFS.
#}
{% set backup_is_nas = ansible_facts['hostname'] == raspberrypi_backup.nas_host %}
set -euo pipefail

# The instance name of the calling unit, which is also the name of the repository
# and of the marker this writes.
readonly NAME="${1:?usage: restic-local-backup <repository>}"

readonly EXCLUDE_FILE="/etc/restic.exclude"
{% if backup_is_nas %}
readonly REPO="{{ raspberrypi_backup.repo_root }}/${NAME}"
# --one-file-system stops the walk at the root filesystem, so the volumes in the
# enclosure are named to be included rather than the rest being excluded.
readonly SRC=(/ {{ raspberrypi_backup.nas_sources | join(' ') }})

# Nothing to mount: the repository is a directory on this host. The unit carries
# RequiresMountsFor so systemd holds it back until the volume is mounted, which
# a boot can otherwise complete without because crypttab uses nofail.
{% else %}
readonly REPO="/mnt/bak"
readonly SRC=(/)
readonly REMOTE="{{ raspberrypi_backup.nas_host }}:{{ raspberrypi_backup.repo_root }}/${NAME}"

# Cleanup function
cleanup() {
  local exit_code="${1:-0}"

  if mountpoint -q "${REPO}"; then
    umount "${REPO}" || {
      echo "Warning: Failed to unmount ${REPO}" >&2
      exit_code=1
    }
  fi

  exit "${exit_code}"
}

# Set trap for cleanup
trap 'cleanup 1' INT TERM EXIT

# Mount remote if not already mounted
if ! mountpoint -q "${REPO}"; then
  mount "${REMOTE}" "${REPO}" || {
    echo "Error: Failed to mount ${REMOTE} to ${REPO}" >&2
    exit 1
  }
fi
{% endif %}

# Initialize repository on first run
if [ ! -f "${REPO}/config" ]; then
  restic init
fi

# Run backup
nice -n 10 restic backup "${SRC[@]}" \
  --verbose \
  --one-file-system \
  --exclude-file="${EXCLUDE_FILE}" \
  --tag daily

# The data is safe at this point. Marking it here keeps a failure below from
# reading as an absent backup: the monitoring threshold is an age in hours, so a
# marker left behind by a retention error would report the data as missing.
touch "/var/lib/restic-local-backup-${NAME}.success"

# Apply retention policy
nice -n 10 restic forget \
  --keep-daily 30 \
  --keep-weekly 8 \
  --keep-monthly 12 \
  --prune

# Retention is a separate promise from the backup, and only this marker means it
# was kept. A failure above still fails the unit, which mails through OnFailure.
touch "/var/lib/restic-local-backup-${NAME}.retention"
{% if not backup_is_nas %}

# Cleanup with success status
trap - INT TERM EXIT
cleanup 0
{% endif %}
