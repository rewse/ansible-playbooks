network:
  version: 2
  ethernets:
    eth0:
      dhcp4: false
      dhcp6: false
      mtu: 1500
      ipv6-mtu: 1500
      accept-ra: true
      optional: true
      addresses:
         - {{ local.ip }}/24
      routes:
        - to: default
          via: {{ raspberrypi_default_gateway }}
          metric: 100
        - to: {{ raspberrypi_aws_vpc_cidr }}
          via: {{ raspberrypi_default_gateway }}
      nameservers:
        # IPv4 only. The router announces its own IPv6 address for this through
        # router advertisement, which accept-ra takes, so naming one here would
        # only add a second copy that goes stale: the address carries the prefix
        # the ISP delegates. A stale one is not obvious either, DNS interception
        # on the router answering queries sent to an address that is gone.
        addresses:
          - {{ raspberrypi_resolved1.ip }}
        search:
          - rewse.jp
  wifis:
    wlan0:
      access-points:
        xray-legacy:
          password: {{ raspberrypi_xray_legacy_password }}
          auth:
            key-management: psk
      dhcp4: false
      dhcp6: false
      mtu: 1500
      ipv6-mtu: 1500
      accept-ra: true
      optional: true
      addresses:
         - {{ local.ip_2 }}/24
      routes:
        - to: default
          via: {{ raspberrypi_default_gateway }}
          metric: 200
        - to: {{ raspberrypi_aws_vpc_cidr }}
          via: {{ raspberrypi_default_gateway }}
      nameservers:
        # IPv4 only, for the reason given on eth0.
        addresses:
          - {{ raspberrypi_resolved1.ip }}
        search:
          - rewse.jp
