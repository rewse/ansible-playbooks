#!/usr/bin/env bash
#
# MHZ-19 CO2 sensor data publisher to MQTT
#

set -euo pipefail

readonly VENV_PATH="/opt/mhz19"
readonly MQTT_HOST="hass.rewse.jp"
readonly MQTT_PORT="1883"
readonly MQTT_USER="pub_client"
readonly MQTT_PASS="[% mhz19_mosquitto_password %]"
readonly TOPIC_BASE="mhz19/[% mhz19_location %]"
readonly STATE_FILE="/var/lib/mhz19/state"
readonly MAX_CO2=4900
readonly MAX_STEP=200
readonly STABLE_SPREAD=100

PATH="${VENV_PATH}/bin:${PATH}"

cleanup() {
  local exit_code=$?
  exit "${exit_code}"
}

trap cleanup EXIT
trap 'exit 1' INT TERM HUP

publish_mqtt() {
  local topic="$1"
  local message="$2"
  local attempt

  # Retried because the broker is named, not addressed, and the first run after a
  # boot can land before name resolution answers. The timer's next run is five
  # minutes out, which is long enough for the reading to be stale, and a failure
  # here raises a notification through OnFailure.
  for attempt in 1 2 3; do
    if mosquitto_pub -r -t "${topic}" \
      -u "${MQTT_USER}" -P "${MQTT_PASS}" \
      -h "${MQTT_HOST}" -p "${MQTT_PORT}" \
      -m "${message}"; then
      return 0
    fi

    [[ "${attempt}" -lt 3 ]] && sleep 10
  done

  return 1
}

read_co2() {
  local attempt
  local co2

  # The sensor answers over PWM, where a reading is taken by timing edges, so a
  # host with something else to do misses one and the library gives up. Roughly
  # one reading in five hundred, and the next attempt succeeds. Retried here
  # because the timer's next run is five minutes out, which is long enough for
  # the reading to be stale, and because a failure raises a notification through
  # OnFailure.
  for attempt in 1 2 3; do
    if co2=$(python3 -m mh_z19 --pwm 2>/dev/null | grep -oP "(?<='co2': )\d+") \
      && [[ -n "${co2}" ]]; then
      echo "${co2}"
      return 0
    fi

    [[ "${attempt}" -lt 3 ]] && sleep 5
  done

  return 1
}

filter_co2() {
  local co2="$1"
  local accepted="-"
  local readings=""
  local recent=()
  local diff
  local max
  local min
  local value
  local valid=false

  # A faulty sensor reports values that wander by thousands of ppm from one
  # reading to the next for up to an hour, far faster than room air changes. A
  # reading is accepted when it stays near the last accepted one, or when three
  # consecutive readings agree, which is how a real change of level looks. Values
  # near the 5000 ppm top of the range are always rejected because a faulty
  # sensor can report them several times in a row.
  # The state file holds the last accepted value, or "-" before the first one,
  # followed by the most recent raw readings.
  if [[ -r "${STATE_FILE}" ]]; then
    read -r accepted readings < "${STATE_FILE}" || true
  fi

  # A damaged state file is discarded so it cannot reject every later reading.
  if ! [[ "${accepted}" =~ ^(-|[0-9]+)$ && "${readings}" =~ ^[0-9\ ]*$ ]]; then
    accepted="-"
    readings=""
  fi

  read -ra recent <<< "${readings}"
  recent+=("${co2}")
  if [[ "${#recent[@]}" -gt 3 ]]; then
    recent=("${recent[@]: -3}")
  fi

  if [[ "${co2}" -lt "${MAX_CO2}" ]]; then
    if [[ "${accepted}" == "-" ]]; then
      valid=true
    else
      diff=$(( co2 - accepted ))
      if [[ "${diff#-}" -le "${MAX_STEP}" ]]; then
        valid=true
      fi
    fi

    if [[ "${#recent[@]}" -eq 3 ]]; then
      max="${co2}"
      min="${co2}"
      for value in "${recent[@]}"; do
        if [[ "${value}" -gt "${max}" ]]; then
          max="${value}"
        fi
        if [[ "${value}" -lt "${min}" ]]; then
          min="${value}"
        fi
      done
      if [[ $(( max - min )) -le "${STABLE_SPREAD}" ]]; then
        valid=true
      fi
    fi
  fi

  if [[ "${valid}" == true ]]; then
    accepted="${co2}"
  fi

  mkdir -p "${STATE_FILE%/*}"
  echo "${accepted} ${recent[*]}" > "${STATE_FILE}"

  if [[ "${valid}" != true ]]; then
    echo "rejected: ${co2} ppm, last accepted: ${accepted}" >&2
    return 1
  fi

  echo "${co2}"
}

send_co2() {
  local co2
  local datetime

  # Availability is published before the exit so Home Assistant shows the sensor
  # as unavailable rather than holding the last reading as though it were current.
  if ! co2=$(read_co2); then
    publish_mqtt "${TOPIC_BASE}/state" "offline"
    return 1
  fi

  publish_mqtt "${TOPIC_BASE}/state" "online"

  # A rejected reading keeps the previous value in Home Assistant and is not a
  # failure, so it raises no notification.
  if ! co2=$(filter_co2 "${co2}"); then
    return 0
  fi

  datetime=$(date --iso-8601=seconds)

  publish_mqtt "${TOPIC_BASE}/co2" "{\"datetime\":\"${datetime}\",\"co2\":${co2}}"
}

main() {
  send_co2
}

main "$@"
