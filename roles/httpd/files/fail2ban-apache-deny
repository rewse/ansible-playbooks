#!/usr/bin/python3 -I
"""fail2ban action helper that makes Apache deny the addresses a jail banned.

Usage: fail2ban-apache-deny <state dir> flush <jail>
       fail2ban-apache-deny <state dir> ban|unban <jail> <address>

Behind CloudFront every connection to Apache comes from an edge server, so a
firewall ban stops a banned client only when it connects directly. This keeps
the jail's bans in <state dir>/<jail>.bans and writes <state dir>/<jail>.conf,
which Apache includes server-wide, then reloads Apache gracefully when the set
changed. -R in the generated sections tests the client address mod_remoteip
restores, so the ban holds through CloudFront and for direct connections alike.

The generated sections only deny, like cloudfront-origin.conf: Apache merges If
sections after every other section, so a section that granted access could
override authentication elsewhere.
"""

import fcntl
import ipaddress
import os
import pathlib
import re
import subprocess
import sys
import tempfile

# Addresses per If section. A short expression keeps each condition quick to
# evaluate and far below any parser limit however many addresses are banned.
CHUNK = 100
JAIL_NAME = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.-]*$")
USAGE = (
    "usage: fail2ban-apache-deny <state dir> flush <jail> | ban|unban <jail> <address>"
)

Address = ipaddress.IPv4Address | ipaddress.IPv6Address


def sort_key(address: Address) -> tuple[int, int]:
    return address.version, int(address)


def read_bans(path: pathlib.Path) -> set[Address]:
    if not path.exists():
        return set()
    return {
        ipaddress.ip_address(line.strip())
        for line in path.read_text().splitlines()
        if line.strip()
    }


def render(jail: str, bans: set[Address]) -> str:
    addresses = sorted(bans, key=sort_key)
    lines = [f"# Written by fail2ban-apache-deny for the {jail} jail. Do not edit."]
    for start in range(0, len(addresses), CHUNK):
        condition = " || ".join(
            f"-R '{address.compressed}'" for address in addresses[start : start + CHUNK]
        )
        lines += [f'<If "{condition}">', "    Require all denied", "</If>"]
    return "\n".join(lines) + "\n"


def write_atomically(path: pathlib.Path, text: str) -> None:
    fd, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as file:
        file.write(text)
    os.chmod(temporary, 0o644)
    os.replace(temporary, path)


def parse(argv: list[str]) -> tuple[pathlib.Path, str, str, Address | None]:
    """Returns the state dir, command, jail, and address, or raises ValueError."""
    if len(argv) == 3 and argv[1] == "flush":
        address = None
    elif len(argv) == 4 and argv[1] in ("ban", "unban"):
        address = ipaddress.ip_address(argv[3])
    else:
        raise ValueError(USAGE)
    if not JAIL_NAME.match(argv[2]):
        raise ValueError(f"invalid jail name: {argv[2]!r}")
    return pathlib.Path(argv[0]), argv[1], argv[2], address


def main(argv: list[str]) -> int:
    try:
        state_dir, command, jail, address = parse(argv)
    except ValueError as error:
        print(f"fail2ban-apache-deny: {error}", file=sys.stderr)
        return 2

    bans_path = state_dir / f"{jail}.bans"
    conf_path = state_dir / f"{jail}.conf"
    # Jails run their actions in parallel, and every change ends in a reload.
    with open(state_dir / ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        before = read_bans(bans_path)
        if address is None:
            after: set[Address] = set()
        elif command == "ban":
            after = before | {address}
        else:
            after = before - {address}
        lines = "".join(f"{a.compressed}\n" for a in sorted(after, key=sort_key))
        write_atomically(bans_path, lines)
        write_atomically(conf_path, render(jail, after))
        if after == before:
            return 0
        # try-reload-or-restart leaves a stopped Apache stopped; it reads the
        # file when it next starts.
        return subprocess.run(
            ["systemctl", "try-reload-or-restart", "apache2"], check=False
        ).returncode


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
