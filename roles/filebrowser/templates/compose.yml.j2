  filebrowser:
    container_name: filebrowser
    image: {{ docker_quarantine_image_ref }}
    # Reached only through the Apache vhost, which terminates TLS and is the only
    # place a client can arrive from.
    ports:
      - "127.0.0.1:{{ filebrowser_port }}:{{ filebrowser_port }}"
    # The image bakes in uid 1000 and supports no PUID/PGID, so the runtime user is
    # overridden here. It has to be {{ admin }} to read a 0700 home directory.
    user: "{{ filebrowser_uid }}:{{ filebrowser_gid }}"
    volumes:
      - {{ filebrowser_data_dir }}:/home/filebrowser/data
{% for source in filebrowser_sources %}
      # Read-only at the mount as well as in the config, so a change to either
      # alone cannot make the published tree writable.
      - {{ source.path }}:{{ source.path }}:ro
{% endfor %}
      - /etc/localtime:/etc/localtime:ro
    # The image checks port 80, which is where it listens only if the config says
    # so. Overridden rather than dropped so an unreachable server still shows as
    # unhealthy rather than as no opinion.
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ filebrowser_port }}/health"]
      interval: 30s
      timeout: 3s
      start_period: 10s
      retries: 3
    mem_limit: {{ filebrowser_mem_limit }}
    restart: unless-stopped
