{{ ansible_managed | comment }}
<VirtualHost *:443>
    ServerAdmin hostmaster@rewse.jp
    ServerName {{ filebrowser_hostname }}

    ProxyPreserveHost on
    ProxyRequests off

    # mod_proxy sends X-Forwarded-For, -Host and -Server on its own but not
    # -Proto, and TLS ends here. Without it the backend sees a plain request and
    # builds its own origin as http://, which fails the WebAuthn origin check
    # against the https:// entry in rpOrigins, so no passkey can be registered.
    RequestHeader set X-Forwarded-Proto "https"

    # FileBrowser takes the client address from X-Forwarded-For for its login
    # lockout and audit log, and mod_proxy appends to a header the client sent
    # instead of replacing it. The unset runs in the fixups phase, after
    # mod_remoteip has restored the client address from CloudFront's header and
    # before mod_proxy appends that address, so FileBrowser receives only the
    # restored address and a guesser cannot rotate it. An early unset would race
    # mod_remoteip for the same hook and could leave the edge address instead.
    RequestHeader unset X-Forwarded-For

    # FileBrowser builds the session cookie domain and the WebAuthn origin from
    # the first X-Forwarded-Host value, and mod_proxy appends the real host to a
    # value the client sent, so a client could otherwise choose that first
    # value. Unset in fixups for the same reason as X-Forwarded-For, leaving
    # only the host mod_proxy adds.
    RequestHeader unset X-Forwarded-Host

    # FileBrowser reads the client address from X-Real-IP when X-Forwarded-For
    # is empty, and mod_proxy forwards a client's X-Real-IP untouched. mod_proxy
    # always adds X-Forwarded-For here, so this keeps the lockout and audit log
    # from depending on that default.
    RequestHeader unset X-Real-IP

    ProxyPass / http://localhost:{{ filebrowser_port }}/
    ProxyPassReverse / http://localhost:{{ filebrowser_port }}/

    RewriteEngine on
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule /(.*) ws://localhost:{{ filebrowser_port }}/$1 [P,L]
    RewriteCond %{HTTP:Upgrade} !=websocket [NC]
    RewriteRule /(.*) http://localhost:{{ filebrowser_port }}/$1 [P,L]

    # Uploads and downloads of large media, and archive downloads the server
    # builds on the fly.
    ProxyTimeout 600

    SSLCertificateFile /etc/letsencrypt/live/rewse.jp/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/rewse.jp/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
