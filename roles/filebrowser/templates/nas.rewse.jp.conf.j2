# {{ ansible_managed }}
<VirtualHost *:443>
    ServerAdmin hostmaster@rewse.jp
    ServerName {{ filebrowser_hostname }}

    ProxyPreserveHost on
    ProxyRequests off

    ProxyPass / http://localhost:{{ filebrowser_port }}/
    ProxyPassReverse / http://localhost:{{ filebrowser_port }}/

    RewriteEngine on
    RewriteCond %{HTTP:Upgrade} =websocket [NC]
    RewriteRule /(.*) ws://localhost:{{ filebrowser_port }}/$1 [P,L]
    RewriteCond %{HTTP:Upgrade} !=websocket [NC]
    RewriteRule /(.*) http://localhost:{{ filebrowser_port }}/$1 [P,L]

    # Uploads and downloads of large media, and archive downloads the server
    # builds on the fly.
    ProxyTimeout 600

    SSLCertificateFile /etc/letsencrypt/live/rewse.jp/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/rewse.jp/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
