---
{{ ansible_managed | comment }}
http:
  port: {{ filebrowser_port }}
  baseURL: "/"
  # Share links are built from this. Without it they would carry the address the
  # container sees, which is the loopback interface.
  externalUrl: https://{{ filebrowser_hostname }}
  # Not used, and one less way in.
  disableWebDAV: true
  # Without this the built-in rate limiting and the failed-login lockout count
  # against Apache's address instead of the client's, which switches both off in
  # practice. The audit log addresses, the WebAuthn origin and the session cookie
  # domain read the same headers. Trusting them is safe because the vhost drops
  # the X-Forwarded-For and X-Forwarded-Host a client sends, so only the values
  # Apache adds arrive here.
  trustProxyHeaders: true

server:
  database:
    # Any name but database.db, which v2 refuses to start beside.
    path: /home/filebrowser/data/filebrowser.sqlite
{% if __filebrowser_boltdb_files.matched > 0 %}
    # Present only while the v1 BoltDB file remains in the data directory. v2
    # imports it on a start that finds the SQLite database missing or empty and
    # ignores it otherwise.
    migrateFrom: /home/filebrowser/data/database.db.old
{% endif %}
  # Thumbnails live beside the database on the NVMe and are pruned automatically,
  # because a phone browsing the picture folders will generate a lot of them.
  cacheDir: /home/filebrowser/data/cache
  cacheDirCleanup: true
  # Left on. This project published ten advisories in the first half of 2026,
  # three of them critical, so being told about a release is worth a banner.
  disableUpdateCheck: false
  sources:
{% for source in filebrowser_sources %}
    - path: {{ source.path }}
      name: {{ source.name }}
      config:
        readOnly: true
        defaultEnabled: true
        rules:
          # Keeps .ssh and .config out of both the index and the interface. There
          # are private keys under the first one.
          - ignoreHidden: true
{% for rule in source.rules %}
{% for key, value in rule.items() %}
          - {{ key }}: {{ value }}
{% endfor %}
{% endfor %}
{% endfor %}

auth:
  adminUsername: {{ admin_user }}
  adminPassword: "{{ filebrowser_admin_password }}"
  key: "{{ filebrowser_jwt_secret }}"
  tokenExpirationHours: {{ filebrowser_token_expiration_hours }}
  methods:
    password:
      enabled: true
    # Face ID on the phone, which is the whole point of reaching this over HTTPS
    # rather than mounting SMB.
    passkey:
      enabled: true
      # Derived from the base URL when empty, which here is just "/" and yields no
      # host. A passkey is bound to the relying party ID, so registering against
      # the wrong one produces a credential that never matches at login.
      rpId: {{ filebrowser_hostname }}
      rpOrigins:
        - https://{{ filebrowser_hostname }}

# File operations are granted per source. The built-in defaults allow viewing
# and downloading only, and the source is read-only besides.
userDefaults:
  account:
    permissions:
      admin: false
      api: false
      # Share links are used. The public share paths are where this project's
      # advisories cluster, so the version is worth following closely.
      share: true
