{{ ansible_managed | comment }}
# Where the GnuCash database is; the credentials come with each request.
GQE_DB_HOST={{ gnucash_quick_expense_db_host }}
GQE_DB_PORT={{ gnucash_quick_expense_db_port }}
GQE_DB_NAME={{ gnucash_quick_expense_db_name }}
# The host name is a CNAME of the Aurora endpoint, so verify-full cannot match
# the certificate. The application also accepts only SCRAM authentication,
# which never sends the secret, so a host on the path learns nothing.
GQE_DB_SSLMODE=require
