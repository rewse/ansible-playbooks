{{ ansible_managed | comment }}
#
# The second layer in front of a login the internet can reach: the database
# password is the only credential, so repeated guesses are banned here.
#
# bantime, findtime and maxretry are left to jail.local in the fail2ban role,
# which gives every jail here five attempts in ten minutes and an hour of ban.
#
# backend has to be stated. jail.d/defaults-debian.conf from the package sets
# systemd for every jail, and jail.d is read after jail.local, so a jail that
# names a logpath without this reads the journal instead and monitors no file.
[gnucash-quick-expense]
enabled = true
backend = auto
port = http,https
# The firewall stops direct connections, and apache-deny stops requests that
# arrive through CloudFront, whose edge servers the firewall cannot single out.
action = %(action_)s
         apache-deny
filter = gnucash-quick-expense
logpath = /var/log/apache2/other_vhosts_access.log
