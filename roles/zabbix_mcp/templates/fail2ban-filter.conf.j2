{{ ansible_managed | comment }}
#
# The server answers a missing or wrong bearer token on the MCP endpoint with
# 401. The OAuth metadata under /.well-known is not matched, because a client
# reads it before it sends a token.
#
# The virtual host is pinned because other_vhosts_access.log carries every name
# Apache serves, and the vhost_combined format puts %v:%p ahead of the client
# address, which is why <HOST> is the second field rather than the first.
[Definition]
failregex = ^{{ zabbix_mcp_hostname | regex_escape }}:\d+ <HOST> \S+ \S+ \[\] "\S+ /mcp(?:[/?]\S*)? HTTP/[\d.]+" 401 \d+
ignoreregex =
