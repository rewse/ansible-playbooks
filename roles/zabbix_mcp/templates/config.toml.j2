[server]
transport = "http"
host = "0.0.0.0"
port = 8081
# The MCP SDK rejects any Host header but localhost unless the server names its
# public URL, which also enables the Origin check for that host.
public_url = "{{ zabbix_mcp_public_url }}"
log_level = "info"
log_file = "/var/log/zabbix-mcp/server.log"
{% if zabbix_mcp_auth_token is defined and zabbix_mcp_auth_token %}
auth_token = "{{ zabbix_mcp_auth_token }}"
{% else %}
{{ 'auth_token is required when host is 0.0.0.0' | mandatory }}
{% endif %}
rate_limit = 300
compact_output = true

[zabbix.production]
url = "{{ zabbix_mcp_url }}"
api_token = "{{ zabbix_mcp_api_token }}"
read_only = {{ zabbix_mcp_read_only | lower }}
verify_ssl = true
